{
  "name": "dsh-use",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal DeepSeek Harness (dsh) plugin bundle: declares dsh.bundle.patch so `dsh plugin --profile web add` registers it as a profile layer.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
